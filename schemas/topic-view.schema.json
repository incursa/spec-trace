{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic-view.schema.json",
  "title": "Topic View Definition",
  "description": "Reference schema for portable JSON topic-view selection objects used for derived requirement slices.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-\\d{4,}$"
    },
    "topicViewCaseMode": {
      "type": "string",
      "enum": [
        "sensitive",
        "insensitive"
      ]
    },
    "topicViewSelector": {
      "type": "string",
      "enum": [
        "requirement.id",
        "requirement.title",
        "requirement.statement",
        "requirement.notes",
        "requirement.trace.upstream_refs",
        "requirement.trace.related",
        "requirement.trace.derived_from",
        "requirement.trace.supersedes",
        "requirement.trace.satisfied_by",
        "requirement.trace.implemented_by",
        "requirement.trace.verified_by",
        "artifact.artifact_id",
        "artifact.title",
        "artifact.capability",
        "artifact.tags"
      ]
    },
    "topicViewSelectorList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicViewSelector"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "topicViewRequirementIdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirementId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "topicViewLiteralClause": {
      "type": "object",
      "required": [
        "fields",
        "value",
        "case"
      ],
      "properties": {
        "fields": {
          "$ref": "#/$defs/topicViewSelectorList"
        },
        "value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "case": {
          "$ref": "#/$defs/topicViewCaseMode"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewRegexClause": {
      "type": "object",
      "required": [
        "fields",
        "pattern",
        "case"
      ],
      "properties": {
        "fields": {
          "$ref": "#/$defs/topicViewSelectorList"
        },
        "pattern": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "case": {
          "$ref": "#/$defs/topicViewCaseMode"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewRequirementIdsClause": {
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "$ref": "#/$defs/topicViewRequirementIdList"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewPredicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/topicViewAllPredicate"
        },
        {
          "$ref": "#/$defs/topicViewAnyPredicate"
        },
        {
          "$ref": "#/$defs/topicViewNotPredicate"
        },
        {
          "$ref": "#/$defs/topicViewLiteralPredicate"
        },
        {
          "$ref": "#/$defs/topicViewRegexPredicate"
        },
        {
          "$ref": "#/$defs/topicViewRequirementIdsPredicate"
        }
      ]
    },
    "topicViewAllPredicate": {
      "type": "object",
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topicViewPredicate"
          },
          "minItems": 1
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewAnyPredicate": {
      "type": "object",
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topicViewPredicate"
          },
          "minItems": 1
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewNotPredicate": {
      "type": "object",
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#/$defs/topicViewPredicate"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewLiteralPredicate": {
      "type": "object",
      "required": [
        "literal"
      ],
      "properties": {
        "literal": {
          "$ref": "#/$defs/topicViewLiteralClause"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewRegexPredicate": {
      "type": "object",
      "required": [
        "regex"
      ],
      "properties": {
        "regex": {
          "$ref": "#/$defs/topicViewRegexClause"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewRequirementIdsPredicate": {
      "type": "object",
      "required": [
        "requirement_ids"
      ],
      "properties": {
        "requirement_ids": {
          "$ref": "#/$defs/topicViewRequirementIdsClause"
        }
      },
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "topicViewDefinition": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match": {
          "$ref": "#/$defs/topicViewPredicate"
        },
        "include_requirements": {
          "$ref": "#/$defs/topicViewRequirementIdList"
        },
        "exclude_requirements": {
          "$ref": "#/$defs/topicViewRequirementIdList"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "match"
              ]
            },
            {
              "required": [
                "include_requirements"
              ]
            }
          ]
        }
      ],
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": {}
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/topicViewDefinition"
}

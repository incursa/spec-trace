{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-decisions.schema.json",
  "title": "SpecTrace RFC Review Decision Record",
  "type": "object",
  "required": [
    "source_unit_id",
    "action",
    "requirements"
  ],
  "properties": {
    "source_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "source_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "accept",
        "accept_with_edit",
        "split",
        "merge",
        "skip",
        "gap",
        "quarantine"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "candidate-requirements.schema.json#/$defs/candidateRequirement"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
